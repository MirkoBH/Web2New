# ══════════════════════════════════════════════════════════════
# AutoPulse – Backend ENV de ejemplo
# Copiar a .env y completar con valores reales
# ══════════════════════════════════════════════════════════════

APP_URL=http://localhost:3000
CORS_URL=http://localhost:8080

# Supabase PostgreSQL (Session Pooler puerto 5432)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[DB_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DB_SSL=true

# JWT
JWT_SECRET_PASSWORD=CAMBIAR_POR_CLAVE_LARGA_Y_SEGURA

# Supabase Storage (anon key - visible en dashboard → Settings → API)
SUPABASE_PROJECT_REF=dwgyvocxsstcnilyslam
SUPABASE_ANON_KEY=eyJhbGci...

# Google Gemini (dejar vacío para análisis simulado)
GEMINI_API_KEY=
