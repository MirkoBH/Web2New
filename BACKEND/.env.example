# Copiar como .env y completar. Nunca subir el .env al repositorio.

PORT=3000
NODE_ENV=development

# Conexión a PostgreSQL (Supabase: Project Settings → Database → Connection pooler)
DATABASE_URL=postgresql://usuario:password@host:6543/postgres
# false solo para una base local sin SSL
DB_SSL=true

# Clave para firmar los tokens. Mínimo 32 caracteres. Generar con:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_PASSWORD=

# Orígenes del frontend permitidos, separados por coma
CORS_URL=http://localhost:5500,http://127.0.0.1:5500

# Supabase Storage (Project Settings → API Keys → Secret key)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SECRET_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODELO=qwen/qwen3.8-27b
