# ─────────────────────────────────────────────────────────────
# AutoPulse - Backend - Variables de entorno
# Copiar este archivo a .env y completar con valores reales
# NUNCA subir el .env real al repositorio
# ─────────────────────────────────────────────────────────────

# URL pública de la aplicación (Railway en producción)
APP_URL=http://localhost:3000

# URL del frontend permitida para CORS
CORS_URL=http://localhost:8080

# Cadena de conexión a Supabase (pública / pooler)
DATABASE_PUBLIC_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Cadena de conexión a Supabase (directa / Railway)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Usar SSL en la conexión (true en producción)
DB_SSL=true

# Clave secreta para firmar JWT (mínimo 32 caracteres)
JWT_SECRET_PASSWORD=CAMBIAR_ESTO_POR_UNA_CLAVE_LARGA_Y_SEGURA

# Clave de API de Google Gemini para análisis de imágenes
GEMINI_API_KEY=AIza...
